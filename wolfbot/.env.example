# NGA 登录 Cookie。只保存在本机 .env，不要提交到 GitHub。
# 示例字段通常包含 ngaPassportUid / ngaPassportCid；直接复制浏览器请求里的 Cookie 字符串即可。
NGA_COOKIE=
NGA_BASE_URL=https://bbs.nga.cn
NGA_USER_AGENT=Mozilla/5.0

# 附件 PDF 放到 wolfbot/data/自立自强.pdf 后可不设置。
WOLFBOT_PDF=
WOLFBOT_NGA=

# 任意 OpenAI 兼容模型接口。未配置时仍可使用“规则+BM25检索”模式。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5.6
